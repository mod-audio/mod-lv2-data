@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .

<http://invadarecords.com/plugins/lv2/delay/mono#out>
    a pg:Group ;
    a pg:StereoGroup ;
    lv2:symbol "out" .

<http://invadarecords.com/plugins/lv2/delay/mono>
    a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "Invada Delay Munge (mono in)" ;
    mod:brand "Invada" ;
    mod:label "Delay Munge" ;
    lv2:project <http://invadarecords.com/plugins/lv2/> ;
    lv2:minorVersion 2;
    lv2:microVersion 3;
    rdfs:comment """
The Delay Munge is a unique delay pedal that is great for ambient sounds. 
The Munge effect sets this pedal apart from the rest of the delay pedal family. It alters the shape and feel of each repetition caused by the delay effect. This can be controlled by changing the values of the LFO and Munge knobs and offers a lot of authenticity and dynamics to a sound.

Features:
Modeled by Invada
""";
    doap:license <http://usefulinc.com/doap/licenses/gpl> ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 0 ;
	lv2:symbol "bypass" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_global> ;
	lv2:name "Bypass" ;
	lv2:portProperty lv2:toggled ;
	lv2:default 0.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 1.0 ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 1 ;
	lv2:symbol "mode" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_global> ;
	lv2:name "Mode" ;
	lv2:portProperty lv2:toggled ;
	lv2:default 0.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 1.0 ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 2 ;
	lv2:symbol "mungemode" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_munge> ;
	lv2:name "Munge Mode" ;
	lv2:portProperty lv2:toggled ;
	lv2:default 0.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 1.0 ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 3 ;
	lv2:symbol "munge" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_munge> ;
	lv2:name "Munge" ;
	lv2:default 50.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 100.0 ;
	units:unit units:pc ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 4 ;
	lv2:symbol "LFOcycle" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_lfo> ;
	lv2:name "LFO" ;
	lv2:shortName "Rate" ;
	lv2:default 20.0 ;
	lv2:minimum 2.0 ;
	lv2:maximum 200.0 ;
	units:unit units:s ;
        lv2:portProperty pprops:logarithmic , mod:tapTempo , mod:tempoRelatedDynamicScalePoints ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 5 ;
	lv2:symbol "LFOdepth" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_lfo> ;
	lv2:name "Depth" ;
	lv2:default 0.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 100.0 ;
	units:unit units:pc ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 6 ;
	lv2:symbol "delay1" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay1> ;
	lv2:name "Delay 1" ;
	lv2:shortName "Time 1" ;
	lv2:default 0.3 ;
	lv2:minimum 0.02 ;
	lv2:maximum 2.0 ;
	units:unit units:s ;
        lv2:portProperty pprops:logarithmic , mod:tapTempo , mod:tempoRelatedDynamicScalePoints ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 7 ;
	lv2:symbol "fb1" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay1> ;
	lv2:name "Feedback 1" ;
	lv2:default 50.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 133.3333333333 ;
	units:unit units:pc ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 8 ;
	lv2:symbol "pan1" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay1> ;
	lv2:name "Pan 1" ;
	lv2:default -0.7 ;
	lv2:minimum -1.0 ;
	lv2:maximum 1.0 ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 9 ;
	lv2:symbol "vol1" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay1> ;
	lv2:name "Volume 1" ;
	lv2:default 100.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 100.0 ;
	units:unit units:pc ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 10 ;
	lv2:symbol "delay2" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay2> ;
	lv2:name "Delay 2" ;
	lv2:shortName "Time 2" ;
	lv2:default 0.2 ;
	lv2:minimum 0.02 ;
	lv2:maximum 2.0 ;
	units:unit units:s ;
        lv2:portProperty pprops:logarithmic , mod:tapTempo , mod:tempoRelatedDynamicScalePoints ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 11 ;
	lv2:symbol "fb2" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay2> ;
	lv2:name "Feedback 2" ;
	lv2:default 50.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 133.3333333333 ;
	units:unit units:pc ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 12 ;
	lv2:symbol "pan2" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay2> ;
	lv2:name "Pan 2" ;
	lv2:default 0.7 ;
	lv2:minimum -1.0 ;
	lv2:maximum 1.0 ;
    ] , [
	a lv2:InputPort, lv2:ControlPort ;
	lv2:index 13 ;
	lv2:symbol "vol2" ;
        pg:group <http://invadarecords.com/plugins/lv2/delay/mono#group_delay2> ;
	lv2:name "Volume 2" ;
	lv2:default 100.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 100.0 ;
	units:unit units:pc ;
    ] , [
	a lv2:OutputPort, lv2:ControlPort ;
	lv2:index 14 ;
	lv2:symbol "meterIn" ;
	lv2:name "In" ;
	lv2:default -60.0 ;
	lv2:minimum -60.0 ;
	lv2:maximum 6.0 ;
	units:unit units:db ;
    ] , [
	a lv2:OutputPort, lv2:ControlPort ;
	lv2:index 15 ;
	lv2:symbol "meterOutL" ;
	lv2:name "L Out" ;
	lv2:default -60.0 ;
	lv2:minimum -60.0 ;
	lv2:maximum 6.0 ;
	units:unit units:db ;
    ] , [
	a lv2:OutputPort, lv2:ControlPort ;
	lv2:index 16 ;
	lv2:symbol "meterOutR" ;
	lv2:name "R Out" ;
	lv2:default -60.0 ;
	lv2:minimum -60.0 ;
	lv2:maximum 6.0 ;
	units:unit units:db ;
    ] , [
	a lv2:OutputPort, lv2:ControlPort ;
	lv2:index 17 ;
	lv2:symbol "LFOlamp" ;
	lv2:name "LFO Lamp" ;
	lv2:default 0.0 ;
	lv2:minimum 0.0 ;
	lv2:maximum 4.0 ;
    ] , [
	a lv2:InputPort, lv2:AudioPort ;
	lv2:index 18 ;
	lv2:symbol "in" ;
	lv2:name "In" ;
    ] , [
	a lv2:OutputPort, lv2:AudioPort ;
	lv2:index 19 ;
	lv2:symbol "outL" ;
	lv2:name "L Out" ;
	pg:group <http://invadarecords.com/plugins/lv2/delay/mono#out> ;
	lv2:designation pg:left ;
    ] , [
	a lv2:OutputPort, lv2:AudioPort ;
	lv2:index 20 ;
	lv2:symbol "outR" ;
	lv2:name "R Out" ;
	pg:group <http://invadarecords.com/plugins/lv2/delay/mono#out> ;
	lv2:designation pg:right ;
    ] .

<http://invadarecords.com/plugins/lv2/delay/sum#in>
    a pg:Group ;
    a pg:StereoGroup ;
    lv2:symbol "in" .

<http://invadarecords.com/plugins/lv2/delay/sum#out>
